rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/homeReset/{periodId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validProgress() {
        return periodId.matches('^(daily|weekly)-[0-9]{4}-[0-9]{2}-[0-9]{2}$|^monthly-[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['version', 'tasks', 'updatedAt'])
          && request.resource.data.keys().hasAll(['version', 'tasks', 'updatedAt'])
          && request.resource.data.version == 1
          && request.resource.data.tasks is map
          && request.resource.data.tasks.size() <= 60
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create, update: if owner() && validProgress();
      allow delete: if false;
    }
    // No public collections or shared household documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
